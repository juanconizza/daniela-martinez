# ============================================================
# CONFIGURACIÓN DEL PROYECTO
# Copilar este archivo como .env y completar los valores
# NO subir .env a git (ya está en .gitignore)
# ============================================================

# ------------------------------------------------------------
# CONTACTO (WhatsApp y teléfono)
# Formato internacional sin espacios: +5493511234567
# ------------------------------------------------------------
PUBLIC_CEL_PHONE_NUMBER=+5493512452068
PUBLIC_FIJO_PHONE_NUMBER=+543514702130

# ------------------------------------------------------------
# LANDING /metodo-rec (VSL)
# ------------------------------------------------------------
# URL del video en Vimeo (ej: https://vimeo.com/123456789)
PUBLIC_METODO_REC_VIMEO_URL=

# URL del evento de Calendly a incrustar en /metodo-rec/agendar
# (ej: https://calendly.com/tu-usuario/cita-gratis)
PUBLIC_CALENDLY_URL=

# ------------------------------------------------------------
# META (Facebook/Instagram) ADS
# ------------------------------------------------------------
# ID del Pixel de Meta (obtené en: Meta Ads Manager > Events Manager)
PUBLIC_META_PIXEL_ID=

# Token CAPI para conversiones server-side (MANTENER SECRETO - nunca PUBLIC_)
# Obtené en: Meta Ads Manager > Settings > Data Sources > Web > Tokens
META_CAPI_TOKEN=

# Código de prueba para testear eventos en Meta Events Manager
PUBLIC_TEST_EVENT_CODE=

# Activar/desactivar tracking de Meta (true/false)
PUBLIC_ENABLE_META_TRACKING=false

# Nombre del evento de Meta por defecto (cuando un botón no especifica trackMetaEvent)
PUBLIC_META_EVENT_DEFAULT=Lead

# Moneda por defecto para las conversiones (Meta + Google). Si un botón no
# especifica trackValue, se envía value=1.0 igual, con esta moneda.
PUBLIC_TRACKING_CURRENCY=ARS

# ------------------------------------------------------------
# GOOGLE ADS
# ------------------------------------------------------------
# ID base del tag de Google Ads (ej: AW-123456789)
PUBLIC_GOOGLE_ADS_ID=

# GA4 (Analytics) — OPCIONAL e INDEPENDIENTE de Google Ads. Si lo configurás,
# cada conversión también se manda a GA4 (además de a Ads si corresponde) y el
# PageView dispara un page_view de GA4. Podés tener uno solo de los dos, o ambos.
PUBLIC_GA4_ID=

# Activar/desactivar tracking de Google (true/false) — aplica tanto a Google Ads como a GA4
PUBLIC_ENABLE_GOOGLE_TRACKING=false

# Nombre del evento de Google por defecto (cuando un botón no especifica trackGoogleEvent)
PUBLIC_GOOGLE_EVENT_DEFAULT=generate_lead

# Conversiones de Google Ads — array JSON, agregá tantas como necesites (no hay límite de 1 o 2).
# "key": identificador corto que cada botón referencia (vía data-track-type o
#        la prop trackGoogleConversion/googleConversion). WhatsAppButton usa "whatsapp"
#        y CallButton usa "call" automáticamente si existen esas keys acá.
# "sendTo": el label de conversión que te da Google Ads (Herramientas > Medición > Conversiones)
#
# Si el sitio tiene VARIAS landings compartiendo este mismo array (un solo .env
# para todo el proyecto), cada landing debería usar una key propia namespaced
# (ej. "mamas_whatsapp", "rinoplastia_whatsapp") en vez de la genérica
# "whatsapp" — pasándola por trackGoogleConversion/googleConversion en sus
# botones — para que no se pisen entre sí las conversiones de landings distintas.
PUBLIC_GOOGLE_ADS_CONVERSIONS=[{"key":"whatsapp","sendTo":"AW-17981002696/sJlUCLOthoIcEMingf5C"},{"key":"call","sendTo":"AW-17981002696/KdM_CNXajYIcEMingf5C"},{"key":"contacto_form","sendTo":"AW-17981002696/REEMPLAZAR"}]

# ------------------------------------------------------------
# SUFIJO DE TRÁFICO EN WHATSAPP (opcional, opt-in)
# ------------------------------------------------------------
# Sufijo automático en el mensaje de WhatsApp según de dónde vino el visitante:
# ?gclid=... en la URL → agrega PUBLIC_TRAFFIC_SOURCE_GOOGLE_SUFFIX
# ?fbclid=... en la URL → agrega PUBLIC_TRAFFIC_SOURCE_META_SUFFIX
# Aplica a cualquier link de WhatsApp trackeado (botones y formularios), sin
# tocar código. Apagado por default.
PUBLIC_APPEND_TRAFFIC_SOURCE=false
# PUBLIC_TRAFFIC_SOURCE_GOOGLE_SUFFIX= Los encontré por Google.
# PUBLIC_TRAFFIC_SOURCE_META_SUFFIX= Lo vi en las redes.

# ------------------------------------------------------------
# MICROSOFT CLARITY (heatmaps + grabación de sesiones)
# ------------------------------------------------------------
# Project ID (obtené en: clarity.microsoft.com > tu proyecto > Settings > Setup)
PUBLIC_CLARITY_PROJECT_ID=

# Activar/desactivar (true/false)
PUBLIC_ENABLE_CLARITY_TRACKING=true

# ------------------------------------------------------------
# DESARROLLO
# ------------------------------------------------------------
PUBLIC_DEV=true