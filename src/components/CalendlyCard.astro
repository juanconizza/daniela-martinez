---
/**
 * Tarjeta visual (marco color hueso) que envuelve al CalendlyWidget, usada en
 * /metodo-rec/agendar.
 */
import CalendlyWidget from './CalendlyWidget.astro';

interface Props {
	calendlyUrl: string;
}

const { calendlyUrl } = Astro.props;
---

<div class="relative overflow-hidden rounded-2xl" style="min-width:320px;min-height:600px;">
	<CalendlyWidget calendlyUrl={calendlyUrl} />
</div>

