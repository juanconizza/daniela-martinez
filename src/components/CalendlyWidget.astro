---
/**
 * Widget inline de Calendly, usado en /metodo-rec/agendar. Se carga on-demand
 * ahí nomás (ya no se precarga oculto desde /metodo-rec — el widget.js de
 * Calendly trae Stripe + reCAPTCHA y pesaba ~2.6MB de fondo para el 100% de
 * las visitas, la mayoría sin llegar a agendar).
 *
 * Calendly tarda uno o dos segundos en terminar de renderizar su contenido
 * real (y mandar una altura real por postMessage) desde que el iframe existe.
 * Por eso el widget arranca oculto (opacity:0) con un skeleton de carga
 * encima, y recién se revela cuando llega una altura real (no la mini altura
 * transitoria que manda mientras se está acomodando).
 */
interface Props {
	calendlyUrl: string;
}

const { calendlyUrl } = Astro.props;

// Colores del embed (sin "#") para que Calendly matchee el fondo oscuro de la
// landing en vez de mostrarse blanco — solo se aplica si el plan de Calendly
// soporta "Embed customization" (Standard o superior).
const buildCalendlyEmbedUrl = (url: string) => {
	if (!url) return "";
	const separator = url.includes("?") ? "&" : "?";
	return `${url}${separator}background_color=150d0a&text_color=f2e6da&primary_color=c1694f`;
};
const calendlyEmbedUrl = buildCalendlyEmbedUrl(calendlyUrl);
---

{calendlyUrl && (
	<>
		<div
			id="calendly-widget"
			class="calendly-inline-widget is-loading"
			data-url={calendlyEmbedUrl}
			style="width:100%;height:100%;min-width:280px;"
		>
		</div>
		<div class="calendly-skeleton absolute inset-0 flex flex-col items-center justify-center gap-3 bg-[#f5ece3]" data-skeleton>
			<span class="calendly-spinner" aria-hidden="true"></span>
			<span class="text-sm font-medium text-[#8a6a52]">Cargando calendario…</span>
		</div>
	</>
)}

<script is:inline src="https://assets.calendly.com/assets/external/widget.js"></script>
<script is:inline>
	// @ts-nocheck
	function setupCalendlyResize() {
		const widget = document.getElementById("calendly-widget");
		if (!widget) return;

		const skeleton = widget.parentElement?.querySelector("[data-skeleton]");

		// Defensivo ante un re-setup sobre el mismo nodo (ej. HMR en dev) — se
		// limpia el listener anterior para no duplicarlo.
		if (widget.__calendlyCleanup) widget.__calendlyCleanup();

		let settled = !widget.classList.contains("is-loading");

		const reveal = () => {
			if (settled) return;
			settled = true;
			widget.classList.remove("is-loading");
			skeleton?.classList.add("is-hidden");
		};

		const onMessage = (event) => {
			if (event.origin !== "https://calendly.com") return;
			if (event.data?.event !== "calendly.page_height") return;
			// Calendly ya manda el valor con "px" incluido (ej. "1159px")
			const height = event.data.payload?.height;
			if (!height) return;
			widget.style.height = String(height).includes("px") ? String(height) : `${height}px`;

			// Mientras se reacomoda al tamaño real manda alturas mini de sobra
			// (2px, 26px) — solo consideramos "listo" una altura de calendario
			// real, si no el skeleton se saca antes de tiempo y se ve roto.
			const numericHeight = parseInt(height, 10);
			if (numericHeight >= 150) reveal();
		};

		window.addEventListener("message", onMessage);
		widget.__calendlyCleanup = () => window.removeEventListener("message", onMessage);
	}

	document.addEventListener("astro:page-load", setupCalendlyResize);
</script>

<style>
	.calendly-inline-widget.is-loading {
		opacity: 0;
	}

	.calendly-inline-widget {
		transition: opacity 300ms ease;
	}

	.calendly-skeleton {
		transition: opacity 300ms ease;
		pointer-events: none;
	}

	.calendly-skeleton.is-hidden {
		opacity: 0;
	}

	.calendly-spinner {
		width: 28px;
		height: 28px;
		border-radius: 9999px;
		border: 3px solid rgba(193, 105, 79, 0.25);
		border-top-color: #c1694f;
		animation: calendlySpin 800ms linear infinite;
	}

	@keyframes calendlySpin {
		to { transform: rotate(360deg); }
	}
</style>
