---
/**
 * Microsoft Clarity — heatmaps + grabación de sesiones
 * =========================================================
 * Snippet oficial en el <head>, mismo patrón que MetaPixel.astro/GoogleAdsPixel.astro:
 * self-gateado por env var, cero dependencias nuevas. El paquete npm
 * @microsoft/clarity solo suma valor si hace falta la API en JS
 * (Clarity.identify()/setTag()/consent()) — no hace falta para heatmaps/
 * grabación pasiva en una landing sin cuentas de usuario.
 */
const toBoolean = (value: unknown, defaultValue: boolean) => {
  if (value === undefined || value === null || value === "") return defaultValue;
  if (typeof value === "boolean") return value;
  const normalized = String(value).trim().toLowerCase();
  return ["1", "true", "yes", "on"].includes(normalized);
};

const clarityProjectId = String(import.meta.env.PUBLIC_CLARITY_PROJECT_ID ?? "").trim();
const enableClarityTracking = toBoolean(import.meta.env.PUBLIC_ENABLE_CLARITY_TRACKING, true);
const shouldLoadClarity = Boolean(clarityProjectId && enableClarityTracking);
---

{
  shouldLoadClarity && (
    <script define:vars={{ clarityProjectId }}>
      (function (c, l, a, r, i, t, y) {
        c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
        t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i;
        y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
      })(window, document, "clarity", "script", clarityProjectId);
    </script>
  )
}
