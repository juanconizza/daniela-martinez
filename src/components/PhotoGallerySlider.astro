---
import { Image } from 'astro:assets';

interface Props {
  autoplay?: boolean;
  interval?: number;
  class?: string;
  folderPath?: string;
  desktopPerView?: number;
  mobilePerView?: number;
  showArrows?: boolean;
  showDots?: boolean;
  imageClass?: string;
}

const {
  autoplay = true,
  interval = 5000,
  class: className = "",
  folderPath = "",
  desktopPerView = 3,
  mobilePerView = 1,
  showArrows = true,
  showDots = true,
  imageClass = "w-full h-[300px] md:h-[400px] object-cover",
} = Astro.props;

// Import all images from galeria folder and subfolders
const allImages = import.meta.glob<{ default: ImageMetadata }>('../images/galeria/**/*.{jpg,jpeg,png,webp,avif}', { eager: true });

// Filter images based on folderPath prop
const images = folderPath 
  ? Object.fromEntries(
      Object.entries(allImages).filter(([path]) => 
        path.includes(`/galeria/${folderPath}/`)
      )
    )
  : Object.fromEntries(
      Object.entries(allImages).filter(([path]) => {
        // Only include images directly in /galeria/ (not in subfolders)
        const afterGaleria = path.split('/galeria/')[1];
        return afterGaleria && !afterGaleria.includes('/');
      })
    );

const imageEntries = Object.entries(images).map(([path, module]) => ({
  src: module.default,
  alt: path.split('/').pop()?.replace(/\.[^.]+$/, '') || 'Galería',
}));

const sliderId = `gallery-${Math.random().toString(36).slice(2, 8)}`;
---

<div
  id={sliderId}
  class={`photo-gallery-slider ${className}`}
  data-autoplay={autoplay}
  data-interval={interval}
  data-desktop-per-view={desktopPerView}
  data-mobile-per-view={mobilePerView}
>
  <div class="overflow-hidden">
    <div class="gallery-track flex -mx-2" data-track>
      {imageEntries.map((item) => (
        <div class="gallery-slide px-2" data-slide>
          <div class="h-full">
            <Image
              src={item.src}
              alt={item.alt}
              width={600}
              height={400}
              format="avif"
              loading="lazy"
              class={imageClass}
            />
          </div>
        </div>
      ))}
    </div>
  </div>

  {showDots && (
    <div class="mt-6 flex items-center justify-center gap-2 min-h-[20px]" data-dots></div>
  )}
  
  {showArrows && (
    <div class="mt-4 hidden md:flex items-center justify-center gap-4">
      <button
        type="button"
        class="rounded-full bg-white border border-color-1 px-5 py-3 text-color-1 hover:text-white hover:bg-color-1 transition text-3xl font-bold"
        data-prev
        aria-label="Anterior"
      >
        ←
      </button>
      <button
        type="button"
        class="rounded-full bg-white border border-color-1 px-5 py-3 text-color-1 hover:text-white hover:bg-color-1 transition text-3xl font-bold"
        data-next
        aria-label="Siguiente"
      >
        →
      </button>
    </div>
  )}
</div>

<style>
  .gallery-slide {
    flex: 0 0 100%;
  }

  .gallery-track {
    transition: transform 500ms ease;
    will-change: transform;
  }

  .photo-gallery-slider {
    touch-action: pan-y;
  }
</style>

<script define:vars={{ sliderId }}>
  function setupPhotoGallerySlider() {
    const root = document.getElementById(sliderId);

    if (!root) {
      return;
    }

    // Si ya había un slider corriendo en este root de una visita anterior a
    // esta página, frenarlo antes de armar uno nuevo (si no, se acumulan
    // setInterval del autoplay y listeners de resize en document/window).
    if (root.__galleryCleanup) {
      root.__galleryCleanup();
    }

    const track = root.querySelector("[data-track]");
    const slides = Array.from(root.querySelectorAll("[data-slide]"));
    const prevButton = root.querySelector("[data-prev]");
    const nextButton = root.querySelector("[data-next]");
    const dotsContainer = root.querySelector("[data-dots]");
    const autoplay = root.dataset.autoplay !== "false";
    const interval = Number(root.dataset.interval || "5000");
    const desktopPerView = Number(root.dataset.desktopPerView || "3");
    const mobilePerView = Number(root.dataset.mobilePerView || "1");

    if (!(track instanceof HTMLElement) || slides.length === 0) {
      return;
    }

    let index = 0;
    let timer = null;
    let startX = null;
    let deltaX = 0;
    let manualInteraction = false;

    const getPerView = () => (window.matchMedia("(min-width: 768px)").matches ? desktopPerView : mobilePerView);

    const updateSlideStyles = () => {
      const perView = getPerView();
      const percentage = (100 / perView).toFixed(4);
      slides.forEach(slide => {
        slide.style.flexBasis = `${percentage}%`;
      });
    };

    const getMaxIndex = () => {
      const perView = getPerView();
      return Math.max(0, slides.length - perView);
    };

    const getPageCount = () => {
      const perView = getPerView();
      if (perView === 1) {
        return slides.length;
      }
      return Math.max(1, Math.ceil(slides.length / perView));
    };

    const setIndex = (nextIndex) => {
      const maxIndex = getMaxIndex();
      index = Math.min(Math.max(0, nextIndex), maxIndex);
      update();
    };

    const updateDots = () => {
      if (!dotsContainer) return;
      
      const perView = getPerView();
      const maxIndex = getMaxIndex();
      let activeIndex;
      if (perView === 1) {
        activeIndex = index;
      } else {
        if (index >= maxIndex) {
          activeIndex = getPageCount() - 1;
        } else {
          activeIndex = Math.floor(index / perView);
        }
      }
      
      dotsContainer.querySelectorAll("button").forEach((dot, dotIndex) => {
        const isActive = dotIndex === activeIndex;
        dot.classList.toggle("is-active", isActive);
        dot.setAttribute('aria-current', isActive ? 'page' : 'false');
        
        if (isActive) {
          dot.style.backgroundColor = 'var(--color-1)';
          dot.style.transform = 'scale(1.2)';
        } else {
          dot.style.backgroundColor = 'white';
          dot.style.transform = 'scale(1)';
        }
      });
    };

    const update = () => {
      const slideWidth = slides[0].getBoundingClientRect().width;
      track.style.transform = `translateX(${-index * slideWidth}px)`;
      updateDots();
    };

    const buildDots = () => {
      if (!dotsContainer) return;
      
      dotsContainer.innerHTML = "";
      const pageCount = getPageCount();
      const perView = getPerView();
      
      dotsContainer.style.display = 'flex';
      dotsContainer.style.gap = '8px';
      dotsContainer.style.padding = '10px 0';
      
      for (let i = 0; i < pageCount; i += 1) {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "gallery-dot";
        button.setAttribute('aria-label', `Ir a imagen ${i + 1} de ${pageCount}`);
        button.setAttribute('aria-current', i === 0 ? 'page' : 'false');
        
        const isMobile = perView === 1;
        button.style.width = isMobile ? '16px' : '12px';
        button.style.height = isMobile ? '16px' : '12px';
        button.style.borderRadius = '50%';
        button.style.border = '1px solid var(--color-1)';
        button.style.backgroundColor = 'white';
        button.style.cursor = 'pointer';
        button.style.padding = '0';
        button.style.margin = '0';
        button.style.display = 'block';
        button.style.flexShrink = '0';
        button.style.transition = 'all 200ms ease';
        
        button.addEventListener("click", () => {
          const maxIndex = getMaxIndex();
          let targetIndex;
          if (perView === 1) {
            targetIndex = i;
          } else {
            targetIndex = (i === pageCount - 1) ? maxIndex : i * perView;
          }
          setIndex(targetIndex);
          manualInteraction = true;
          stopAutoplay();
        });
        dotsContainer.appendChild(button);
      }
    };

    const goNext = () => {
      const perView = getPerView();
      const maxIndex = getMaxIndex();
      
      if (perView === 1) {
        const nextIndex = index + 1;
        if (nextIndex > maxIndex) {
          setIndex(0);
        } else {
          setIndex(nextIndex);
        }
      } else {
        const pageCount = getPageCount();
        const currentPage = index >= maxIndex ? pageCount - 1 : Math.floor(index / perView);
        const nextPage = currentPage + 1;
        
        if (nextPage >= pageCount) {
          setIndex(0);
        } else if (nextPage === pageCount - 1) {
          setIndex(maxIndex);
        } else {
          setIndex(nextPage * perView);
        }
      }
    };

    const goPrev = () => {
      const perView = getPerView();
      const maxIndex = getMaxIndex();
      
      if (perView === 1) {
        const prevIndex = index - 1;
        if (prevIndex < 0) {
          setIndex(maxIndex);
        } else {
          setIndex(prevIndex);
        }
      } else {
        const pageCount = getPageCount();
        const currentPage = index >= maxIndex ? pageCount - 1 : Math.floor(index / perView);
        const prevPage = currentPage - 1;
        
        if (prevPage < 0) {
          setIndex(maxIndex);
        } else if (prevPage === pageCount - 1) {
          setIndex(maxIndex);
        } else {
          setIndex(prevPage * perView);
        }
      }
    };

    const startAutoplay = () => {
      if (!autoplay) {
        return;
      }
      timer = window.setInterval(goNext, interval);
    };

    const stopAutoplay = () => {
      if (timer) {
        window.clearInterval(timer);
        timer = null;
      }
    };

    prevButton?.addEventListener("click", () => {
      goPrev();
      manualInteraction = true;
      stopAutoplay();
    });

    nextButton?.addEventListener("click", () => {
      goNext();
      manualInteraction = true;
      stopAutoplay();
    });

    root.addEventListener("mouseenter", stopAutoplay);
    root.addEventListener("mouseleave", () => {
      if (!manualInteraction) {
        startAutoplay();
      }
    });

    const onPointerDown = (event) => {
      if (event.pointerType === "mouse") {
        return;
      }
      startX = event.clientX;
      deltaX = 0;
      manualInteraction = true;
      stopAutoplay();
      root.setPointerCapture(event.pointerId);
    };

    const onPointerMove = (event) => {
      if (startX === null) {
        return;
      }
      deltaX = event.clientX - startX;
      if (Math.abs(deltaX) > 5) {
        event.preventDefault();
      }
    };

    const onPointerUp = (event) => {
      if (startX === null) {
        return;
      }

      const threshold = 50;
      if (deltaX > threshold) {
        goPrev();
      } else if (deltaX < -threshold) {
        goNext();
      }

      startX = null;
      deltaX = 0;
      if (event?.pointerId !== undefined) {
        root.releasePointerCapture(event.pointerId);
      }
    };

    root.addEventListener("pointerdown", onPointerDown, { passive: false });
    root.addEventListener("pointermove", onPointerMove, { passive: false });
    root.addEventListener("pointerup", onPointerUp);
    root.addEventListener("pointercancel", onPointerUp);

    const onResize = () => {
      updateSlideStyles();
      buildDots();
      setIndex(0);
    };

    window.addEventListener("resize", onResize);
    root.__galleryCleanup = () => {
      stopAutoplay();
      window.removeEventListener("resize", onResize);
    };

    updateSlideStyles();
    buildDots();
    update();
    startAutoplay();
  }

  // astro:page-load dispara en la carga inicial Y en cada navegación con
  // ClientRouter — necesario porque este script no se re-ejecuta solo al
  // volver a una página ya visitada.
  document.addEventListener('astro:page-load', setupPhotoGallerySlider);
</script>
