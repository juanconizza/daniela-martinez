---
interface Props {
	vimeoUrl: string;
	class?: string;
	borderWidth?: number;
	borderColor?: string;
	/** Identifica el video en los reportes de Meta/GA4. Si el sitio tiene
	 * varias landings compartiendo la misma property/Pixel, incluí el nombre
	 * de la landing acá (ej. "Hero mamas") para que no se pisen los labels
	 * entre landings distintas. Default: "Video". */
	trackLabel?: string;
}

const {
	vimeoUrl,
	class: className = "",
	borderWidth = 4,
	borderColor = "var(--color-4)",
	trackLabel = "Video",
} = Astro.props;

const getVimeoId = (url: string) => {
	const match = url.match(/vimeo\.com\/(?:video\/)?(\d+)/i);
	return match?.[1] ?? "";
};

const vimeoId = getVimeoId(vimeoUrl);
const playerUrl = vimeoId
	? `https://player.vimeo.com/video/${vimeoId}?autoplay=1&muted=0&autopause=0&playsinline=0&title=0&byline=0&portrait=0&responsive=1&app_id=122963&recommend=0&loop=1`
	: "";

let thumbnailUrl = "";
if (vimeoId) {
	try {
		const response = await fetch(`https://vimeo.com/api/v2/video/${vimeoId}.json`);
		if (response.ok) {
			const data = await response.json();
			thumbnailUrl = data[0]?.thumbnail_large || data[0]?.thumbnail_medium || "";
		}
	} catch (err) {
		console.error("Error fetching Vimeo thumbnail:", err);
	}
}

const componentId = `vimeo-${Math.random().toString(36).slice(2, 8)}`;
---

<div id={componentId} class={`vimeo-video mt-3 ${className}`} data-player-url={playerUrl} style={`--vimeo-border-width: ${borderWidth}px; --vimeo-border-color: ${borderColor}`}>
	<button
		type="button"
		class="vimeo-trigger"
		data-open
		data-track-lead="true"
		data-track-type="video"
		data-track-meta-event="ViewContent"
		data-track-google-event="video_start"
		data-button-text={trackLabel}
	>
		{thumbnailUrl && (
			<img src={thumbnailUrl} alt="Video thumbnail" class="vimeo-thumbnail" loading="lazy" />
		)}
		<div class="vimeo-play-icon" aria-hidden="true">
			<svg width="60" height="60" viewBox="0 0 60 60" fill="currentColor">
				<polygon points="20,10 50,30 20,50" />
			</svg>
		</div>
	</button>

	<div class="vimeo-overlay" data-overlay aria-hidden="true">
		<div class="vimeo-surface" role="dialog" aria-modal="true" aria-label="Video">
			<button type="button" class="vimeo-close" data-close aria-label="Cerrar">
				×
			</button>
			<div class="vimeo-frame" data-frame></div>
		</div>
	</div>
</div>

<style>
	.vimeo-trigger {
		position: relative;
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border: var(--vimeo-border-width, 3px) solid var(--vimeo-border-color, var(--color-4));
		background: #000;
		cursor: pointer;
		padding: 0;
		margin: 0;
		transition: transform 200ms ease, filter 200ms ease;
	}

	.vimeo-trigger:hover {
		transform: scale(1.02);
		filter: brightness(1.1);
	}

	.vimeo-thumbnail {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.vimeo-play-icon {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(0, 0, 0, 0.3);
		color: #ffffff;
		transition: background 200ms ease, color 200ms ease;
	}

	.vimeo-trigger:hover .vimeo-play-icon {
		background: rgba(0, 0, 0, 0.5);
	}

	.vimeo-overlay {
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.85);
		display: none;
		z-index: 99999;
		padding: 0px !important;
		margin: 100px !important;
		overflow: auto;
	}

	.vimeo-overlay.is-open {
		display: flex;
	}

	.vimeo-surface {
		position: relative;
		width: 98vw;
		height: 100%;
		background: #000;
		box-sizing: border-box;
		margin: 0;
	}

	.vimeo-frame {
		position: absolute;
		inset: 0;
		overflow: hidden;
		width: 100% !important;
		height: 100% !important;
	}

	.vimeo-frame iframe {
		width: 100% !important;
		height: 100% !important;
		border: 0 !important;
		display: block;
		margin: 0;
		padding: 0;
	}

	.vimeo-close {
		position: absolute;
		top: 10px;
		right: 10px;
		width: 50px;
		height: 50px;
		border-radius: 9999px;
		background: #ffffff;
		color: #000000;
		border: none;
		font-size: 36px;
		line-height: 1;
		cursor: pointer;
		transition: transform 200ms ease, background 200ms ease;
		display: flex;
		align-items: center;
		justify-content: center;
		padding-bottom: 3px;
		z-index: 10000;
	}

	.vimeo-close:hover {
		transform: scale(1.15);
		background: #f0f0f0;
	}

	.vimeo-close:active {
		transform: scale(0.95);
	}

	@media (max-width: 768px) {
		.vimeo-overlay {
			margin: 0 !important;
			padding: 0 !important;
		}

		.vimeo-surface {
			width: 100vw;
		}

		.vimeo-close {
			width: 40px;
			height: 40px;
			font-size: 28px;
		}
	}
</style>

<script define:vars={{ componentId }}>
	function setupVimeoVideo() {
		const root = document.getElementById(componentId);
		if (!root) return;

		// Si ya había un setup corriendo en este root de una visita anterior a
		// esta página (astro:page-load puede volver a dispararse sin recargar),
		// sacar sus listeners globales antes de agregar los nuevos.
		if (root.__vimeoCleanup) {
			root.__vimeoCleanup();
		}

		const openButton = root.querySelector("[data-open]");
		const overlay = root.querySelector("[data-overlay]");
		const closeButton = root.querySelector("[data-close]");
		const frame = root.querySelector("[data-frame]");
		const playerUrl = root.getAttribute("data-player-url");
		const originalOverlayParent = overlay?.parentElement;

		if (!(overlay instanceof HTMLElement) || !(frame instanceof HTMLElement) || !playerUrl) {
			return;
		}

		const open = () => {
			if (overlay.parentElement !== document.body) {
				document.body.appendChild(overlay);
			}

			overlay.classList.add("is-open");
			overlay.setAttribute("aria-hidden", "false");
			frame.innerHTML = `<iframe src="${playerUrl}" width="100%" height="100%" style="width:100%;height:100%;border:none;" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>`;
		};

		const close = () => {
			overlay.classList.remove("is-open");
			overlay.setAttribute("aria-hidden", "true");
			frame.innerHTML = "";

			if (originalOverlayParent && overlay.parentElement !== originalOverlayParent) {
				originalOverlayParent.appendChild(overlay);
			}
		};

		const onOverlayClick = (event) => {
			if (event.target === overlay) {
				close();
			}
		};

		// Click afuera del modal y Escape se escuchan en document/window (que
		// persisten entre navegaciones) — por eso necesitan cleanup explícito,
		// a diferencia de los listeners en elementos dentro de root.
		const onDocumentClick = (event) => {
			if (!overlay.classList.contains("is-open")) return;
			if (!(event.target instanceof Node)) return;
			if (openButton instanceof HTMLElement && openButton.contains(event.target)) return;

			if (!overlay.contains(event.target)) {
				close();
			}
		};

		const onKeydown = (event) => {
			if (event.key === "Escape") {
				close();
			}
		};

		openButton?.addEventListener("click", open);
		closeButton?.addEventListener("click", close);
		overlay.addEventListener("click", onOverlayClick);
		document.addEventListener("click", onDocumentClick);
		window.addEventListener("keydown", onKeydown);

		root.__vimeoCleanup = () => {
			document.removeEventListener("click", onDocumentClick);
			window.removeEventListener("keydown", onKeydown);
		};
	}

	// astro:page-load dispara en la carga inicial Y en cada navegación con
	// ClientRouter — necesario porque este script no se re-ejecuta solo al
	// volver a una página ya visitada.
	document.addEventListener('astro:page-load', setupVimeoVideo);
</script>
