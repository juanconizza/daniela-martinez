---
/**
 * Video de VSL con carga en dos capas para que se sienta instantáneo:
 *
 *  1. Un <video> local (mp4 muteado, corto, liviano) con los primeros
 *     segundos reales se autorreproduce en loop apenas carga la página — es
 *     same-origin, así que pinta al instante, sin esperar a Vimeo.
 *  2. En simultáneo, el iframe real de Vimeo se crea y empieza a cargar
 *     oculto detrás. Cuando el visitante clickea "activar sonido": si Vimeo
 *     ya avisó por postMessage que está "ready", se revela al instante
 *     (arranca desde el segundo 0, con sonido); si todavía no cargó, el
 *     placeholder se queda loopeando (nunca se congela) y el swap se hace
 *     solo apenas Vimeo esté listo.
 *
 * A diferencia de VimeoVideo.astro (que abre un modal), este va embebido
 * directo en la página.
 */
interface Props {
	vimeoUrl: string;
	placeholderSrc?: string;
	class?: string;
}

const { vimeoUrl, placeholderSrc = "/videos/metodo-rec-preview.mp4", class: className = "" } = Astro.props;

const getVimeoId = (url: string) => {
	if (!url) return "";
	const match = url.match(/vimeo\.com\/(?:video\/)?(\d+)/i);
	return match?.[1] ?? "";
};

const vimeoId = getVimeoId(vimeoUrl);
const playerUrl = vimeoId
	? `https://player.vimeo.com/video/${vimeoId}?autoplay=1&muted=1&loop=0&playsinline=1&title=0&byline=0&portrait=0&controls=0&dnt=1&api=1`
	: "";

const componentId = `vsl-video-${Math.random().toString(36).slice(2, 8)}`;
---

<div
	id={componentId}
	class={`vsl-video relative aspect-[16/9] md:aspect-video w-full overflow-hidden rounded-2xl border border-white/10 bg-black shadow-[0_20px_60px_rgba(0,0,0,0.5)] ${className}`}
	data-player-url={playerUrl}
>
	{vimeoId ? (
		<>
			<video
				class="vsl-placeholder absolute inset-0 h-full w-full object-cover"
				data-placeholder
				src={placeholderSrc}
				autoplay
				muted
				loop
				playsinline
				preload="auto"
			></video>
			<div class="vsl-frame absolute inset-0 opacity-0" data-frame></div>
			<button
				type="button"
				class="vsl-unmute absolute inset-0 flex items-end justify-center pb-5 md:pb-7 bg-black/10"
				data-unmute
				data-track-lead="true"
				data-track-type="video"
				data-track-meta-event="ViewContent"
				data-track-google-event="video_play"
				data-button-text="Metodo REC - Activar sonido"
				aria-label="Activar el sonido del video"
			>
				<span class="vsl-unmute-badge inline-flex items-center gap-2 rounded-full bg-black/70 backdrop-blur px-4 py-2 text-xs md:text-sm font-semibold text-white">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M11 5 6 9H2v6h4l5 4V5Z"></path>
						<line x1="23" y1="9" x2="17" y2="15"></line>
						<line x1="17" y1="9" x2="23" y2="15"></line>
					</svg>
					Tocá para activar el sonido
				</span>
			</button>
			<button
				type="button"
				class="vsl-fullscreen absolute bottom-3 right-3 flex h-9 w-9 items-center justify-center rounded-full bg-black/60 text-white backdrop-blur transition-colors hover:bg-black/80"
				data-fullscreen
				aria-label="Ver en pantalla completa"
			>
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M8 3H5a2 2 0 0 0-2 2v3"></path>
					<path d="M21 8V5a2 2 0 0 0-2-2h-3"></path>
					<path d="M3 16v3a2 2 0 0 0 2 2h3"></path>
					<path d="M16 21h3a2 2 0 0 0 2-2v-3"></path>
				</svg>
			</button>
		</>
	) : (
		<div class="absolute inset-0 flex flex-col items-center justify-center gap-2 text-white/50 text-sm">
			<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
				<polygon points="5 3 19 12 5 21 5 3"></polygon>
			</svg>
			Video próximamente
		</div>
	)}
</div>

<style>
	.vsl-unmute-badge {
		animation: vslPulse 1.8s ease-in-out infinite;
	}

	@keyframes vslPulse {
		0%, 100% { transform: scale(1); }
		50% { transform: scale(1.05); }
	}

	.vsl-unmute.is-muted-off {
		opacity: 0;
		pointer-events: none;
	}

	.vsl-placeholder,
	.vsl-frame {
		transition: opacity 200ms ease;
	}

	.vsl-placeholder.is-swapped {
		opacity: 0;
	}

	.vsl-frame.is-swapped {
		opacity: 1;
	}
</style>

<script define:vars={{ componentId }}>
	function setupVslVideo() {
		const root = document.getElementById(componentId);
		if (!root) return;

		const frame = root.querySelector("[data-frame]");
		const playerUrl = root.getAttribute("data-player-url");
		const unmuteBtn = root.querySelector("[data-unmute]");
		const placeholder = root.querySelector("[data-placeholder]");
		if (!frame || !playerUrl) return;

		let iframe = frame.querySelector("iframe");
		if (!iframe) {
			iframe = document.createElement("iframe");
			iframe.src = playerUrl;
			iframe.allow = "autoplay; fullscreen; picture-in-picture";
			iframe.allowFullscreen = true;
			iframe.style.cssText = "position:absolute;inset:0;width:100%;height:100%;border:0;";
			frame.appendChild(iframe);
		}

		const postToPlayer = (method, value) => {
			iframe.contentWindow?.postMessage(JSON.stringify({ method, value }), "https://player.vimeo.com");
		};

		// El player de Vimeo avisa por postMessage cuando terminó de inicializar
		// y ya acepta comandos (setCurrentTime/setMuted/play) — mandarlos antes
		// puede no tener efecto, por eso esperamos este evento en vez de asumir
		// que ya está listo apenas se crea el iframe.
		let vimeoReady = false;
		let playRequested = false;
		let revealed = false;
		let fallbackTimer = null;

		const revealVimeo = () => {
			if (revealed) return;
			revealed = true;
			if (fallbackTimer) clearTimeout(fallbackTimer);
			postToPlayer("setCurrentTime", 0);
			postToPlayer("setMuted", false);
			postToPlayer("play");
			placeholder?.classList.add("is-swapped");
			frame.classList.add("is-swapped");
			placeholder?.pause?.();
		};

		const onPlayerMessage = (event) => {
			if (event.origin !== "https://player.vimeo.com") return;
			let data;
			try {
				data = JSON.parse(event.data);
			} catch {
				return;
			}
			if (data.event !== "ready") return;
			vimeoReady = true;
			if (playRequested) revealVimeo();
		};

		if (root.__vslMessageCleanup) root.__vslMessageCleanup();
		window.addEventListener("message", onPlayerMessage);
		root.__vslMessageCleanup = () => window.removeEventListener("message", onPlayerMessage);

		let unmuted = false;
		const unmute = () => {
			if (unmuted) return;
			unmuted = true;
			unmuteBtn?.classList.add("is-muted-off");
			playRequested = true;
			// Si Vimeo ya está listo, se revela al toque; si no, el placeholder
			// se queda loopeando y revealVimeo() se dispara solo desde
			// onPlayerMessage apenas llegue el "ready". Si por lo que sea el
			// "ready" no llega nunca (red lenta, mensaje perdido), no dejamos a
			// la visitante trabada mirando el placeholder para siempre.
			if (vimeoReady) revealVimeo();
			else fallbackTimer = setTimeout(revealVimeo, 4000);
		};

		unmuteBtn?.addEventListener("click", unmute);

		const fullscreenBtn = root.querySelector("[data-fullscreen]");
		fullscreenBtn?.addEventListener("click", (event) => {
			event.stopPropagation();
			if (iframe.requestFullscreen) iframe.requestFullscreen();
			else if (iframe.webkitRequestFullscreen) iframe.webkitRequestFullscreen();
		});
	}

	document.addEventListener("astro:page-load", setupVslVideo);
</script>
