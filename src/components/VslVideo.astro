---
/**
 * Video de VSL con carga en dos capas para que se sienta instantáneo:
 *
 *  1. Un <video> local (mp4 muteado, corto, liviano) con los primeros
 *     segundos reales se autorreproduce en loop apenas carga la página — es
 *     same-origin, así que pinta al instante, sin esperar a Vimeo.
 *  2. El iframe real de Vimeo NO se crea hasta el click en "activar sonido"
 *     (o "pantalla completa") — antes se creaba oculto desde que cargaba la
 *     página, reproduciendo video real de fondo desde el primer segundo, lo
 *     que pesaba la carga inicial para el 100% de las visitas (incluidas las
 *     que rebotan sin tocar nada) a cambio de un swap un poco más instantáneo
 *     para quienes sí llegan a tocar. Ahora, al hacer click: si Vimeo carga
 *     rápido, el swap se siente casi instantáneo igual; si tarda, se ve la
 *     animación de carga en vez de dejar el placeholder solo sin feedback.
 *
 * Usa el SDK oficial de Vimeo (player.js) en vez de armar los mensajes de
 * postMessage a mano — Vimeo mezcla formatos (el handshake inicial viaja
 * como string JSON, pero los eventos suscriptos como timeupeate llegan como
 * objeto directo) y ya nos hizo perder tiempo depurando eso una vez; el SDK
 * expone una API (player.on/play/setCurrentTime, todo con Promises) que
 * abstrae esas inconsistencias.
 *
 * Controles nativos de Vimeo activados (play/pausa/avance) — el placeholder
 * y el badge de "activar sonido" los tapan hasta que se revela el video real.
 *
 * A diferencia de VimeoVideo.astro (que abre un modal), este va embebido
 * directo en la página.
 */
interface Props {
	vimeoUrl: string;
	placeholderSrc?: string;
	class?: string;
}

const { vimeoUrl, placeholderSrc = "/videos/metodo-rec-preview.mp4", class: className = "" } = Astro.props;

const getVimeoId = (url: string) => {
	if (!url) return "";
	const match = url.match(/vimeo\.com\/(?:video\/)?(\d+)/i);
	return match?.[1] ?? "";
};

const vimeoId = getVimeoId(vimeoUrl);
const playerUrl = vimeoId
	? `https://player.vimeo.com/video/${vimeoId}?autoplay=1&muted=1&loop=0&playsinline=1&title=0&byline=0&portrait=0&controls=1&dnt=1`
	: "";

const componentId = `vsl-video-${Math.random().toString(36).slice(2, 8)}`;
---

<div
	id={componentId}
	class={`vsl-video relative aspect-[16/9] md:aspect-video w-full overflow-hidden rounded-2xl border border-white/10 bg-black shadow-[0_20px_60px_rgba(0,0,0,0.5)] ${className}`}
	data-player-url={playerUrl}
	data-vsl-vimeo-id={vimeoId}
>
	{vimeoId ? (
		<>
			<video
				class="vsl-placeholder absolute inset-0 h-full w-full object-cover"
				data-placeholder
				src={placeholderSrc}
				autoplay
				muted
				loop
				playsinline
				preload="auto"
			></video>
			<div class="vsl-frame absolute inset-0 opacity-0" data-frame></div>
			<button
				type="button"
				class="vsl-unmute absolute inset-0 flex items-end justify-center pb-5 md:pb-7 bg-black/10"
				data-unmute
				data-track-lead="true"
				data-track-type="video"
				data-track-meta-event="ViewContent"
				data-track-google-event="video_play"
				data-button-text="Metodo REC - Activar sonido"
			>
				<span class="vsl-unmute-badge inline-flex items-center gap-2 rounded-full bg-black/70 backdrop-blur px-4 py-2 text-xs md:text-sm font-semibold text-white">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M11 5 6 9H2v6h4l5 4V5Z"></path>
						<line x1="23" y1="9" x2="17" y2="15"></line>
						<line x1="17" y1="9" x2="23" y2="15"></line>
					</svg>
					Tocá para activar el sonido
				</span>
			</button>
			<button
				type="button"
				class="vsl-fullscreen absolute bottom-3 right-3 flex h-9 w-9 items-center justify-center rounded-full bg-black/60 text-white backdrop-blur transition-colors hover:bg-black/80"
				data-fullscreen
				aria-label="Ver en pantalla completa"
			>
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M8 3H5a2 2 0 0 0-2 2v3"></path>
					<path d="M21 8V5a2 2 0 0 0-2-2h-3"></path>
					<path d="M3 16v3a2 2 0 0 0 2 2h3"></path>
					<path d="M16 21h3a2 2 0 0 0 2-2v-3"></path>
				</svg>
			</button>
			<div class="vsl-loading absolute inset-0 flex flex-col items-center justify-center gap-2 bg-black/40" data-loading aria-hidden="true">
				<span class="vsl-spinner" aria-hidden="true"></span>
				<span class="text-xs font-medium text-white/90 md:text-sm">Cargando video…</span>
			</div>
		</>
	) : (
		<div class="absolute inset-0 flex flex-col items-center justify-center gap-2 text-white/50 text-sm">
			<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
				<polygon points="5 3 19 12 5 21 5 3"></polygon>
			</svg>
			Video próximamente
		</div>
	)}
</div>

<script is:inline async src="https://player.vimeo.com/api/player.js"></script>

<style>
	.vsl-unmute-badge {
		animation: vslPulse 1.8s ease-in-out infinite;
	}

	@keyframes vslPulse {
		0%, 100% { transform: scale(1); }
		50% { transform: scale(1.05); }
	}

	.vsl-unmute.is-muted-off {
		opacity: 0;
		pointer-events: none;
	}

	.vsl-placeholder,
	.vsl-frame {
		transition: opacity 200ms ease;
	}

	.vsl-placeholder.is-swapped {
		opacity: 0;
	}

	.vsl-frame.is-swapped {
		opacity: 1;
	}

	.vsl-loading {
		opacity: 0;
		pointer-events: none;
		transition: opacity 150ms ease;
	}

	.vsl-loading.is-visible {
		opacity: 1;
	}

	.vsl-spinner {
		width: 32px;
		height: 32px;
		border-radius: 9999px;
		border: 3px solid rgba(255, 255, 255, 0.25);
		border-top-color: #fff;
		animation: vslSpin 800ms linear infinite;
	}

	@keyframes vslSpin {
		to { transform: rotate(360deg); }
	}
</style>

<script define:vars={{ componentId }}>
	// @ts-nocheck
	function setupVslVideo() {
		const root = document.getElementById(componentId);
		if (!root) return;

		const frame = root.querySelector("[data-frame]");
		const playerUrl = root.getAttribute("data-player-url");
		const vimeoId = root.getAttribute("data-vsl-vimeo-id");
		const unmuteBtn = root.querySelector("[data-unmute]");
		const placeholder = root.querySelector("[data-placeholder]");
		const loadingEl = root.querySelector("[data-loading]");
		if (!frame || !playerUrl) return;

		const storageKey = `metodo-rec-vsl-position-${vimeoId}`;

		// Safari en modo privado (y algunos navegadores in-app, como el de Meta
		// Ads en iOS) tiran QuotaExceededError en CUALQUIER escritura a
		// localStorage — sin este wrapper, eso rompía la consola en una porción
		// real de sesiones mobile. Perder el "retomar donde quedó" en esos casos
		// no es grave; dejar sin capturar el error si lo es.
		const safeStorage = {
			get(key) {
				try {
					return localStorage.getItem(key);
				} catch {
					return null;
				}
			},
			set(key, value) {
				try {
					localStorage.setItem(key, value);
				} catch {}
			},
			remove(key) {
				try {
					localStorage.removeItem(key);
				} catch {}
			},
		};

		let iframe = null;
		let player = null;
		let fallbackTimer = null;
		let vimeoReady = false;
		let unmuted = false;

		const showLoading = () => loadingEl?.classList.add("is-visible");
		const hideLoading = () => loadingEl?.classList.remove("is-visible");

		// El video de Vimeo se autorreproduce muteado de fondo desde que carga
		// la página (para estar listo apenas se lo pida) — eso dispara su
		// propio evento "play" real UNA vez, sin que nadie haya tocado nada.
		// Por eso el swap NO puede colgarse del evento "play" del SDK (dispara
		// también con el autoplay de fondo) — se hace solo y únicamente acá
		// adentro, en el click. El pequeño delay le da tiempo a Vimeo a
		// terminar el seek + arrancar a reproducir sin sonido desde la
		// posición correcta antes de mostrarlo, para que no se note el poster
		// estático de Vimeo un instante antes de la reproducción real.
		const swapToVimeo = () => {
			if (iframe.__vslSwapped) return;
			iframe.__vslSwapped = true;
			if (fallbackTimer) clearTimeout(fallbackTimer);
			hideLoading();
			placeholder?.classList.add("is-swapped");
			frame.classList.add("is-swapped");
			placeholder?.pause?.();
			// Después de que termina el fade (200ms, ver CSS) lo saca del todo
			// del DOM — no se queda ni pausado de fondo ni pudiendo asomar.
			setTimeout(() => placeholder?.remove(), 250);

			// El player de Vimeo estuvo reproduciendo oculto (opacity:0) de
			// fondo y no siempre termina de recalcular su tamaño interno al
			// hacerse visible — quedan franjas finitas sin cubrir en los bordes
			// (se nota entrando y saliendo de pantalla completa, que sí fuerza
			// ese recálculo). Un cambio de tamaño real, aunque sea mínimo,
			// dispara el mismo recálculo sin que haga falta el fullscreen.
			requestAnimationFrame(() => {
				iframe.style.width = "99.9%";
				requestAnimationFrame(() => {
					iframe.style.width = "100%";
					window.dispatchEvent(new Event("resize"));
				});
			});
		};

		// Crea el iframe real de Vimeo + la instancia del SDK recién la primera
		// vez que hace falta (al activar) — antes esto corría apenas cargaba la
		// página, así que el video real ya estaba reproduciendo oculto de fondo
		// desde el primer segundo para el 100% de las visitas.
		const ensurePlayer = () => {
			if (player) return player;

			// El SDK (player.js) carga async, en paralelo, desde que arrancó la
			// página — normalmente ya está listo mucho antes de que alguien
			// llegue a hacer click. Si por algún motivo alguien clickea en el
			// primerísimo instante, antes de que termine de bajar, no hay
			// instancia que crear todavía: se devuelve null y activate() reintenta
			// enseguida en vez de romper con un TypeError.
			if (!window.Vimeo) return null;

			iframe = document.createElement("iframe");
			iframe.src = playerUrl;
			iframe.title = "Video: Así dejé de sufrir por amor y recuperé mi paz";
			// "fullscreen" ya va en allow (forma moderna) — allowFullscreen es el
			// atributo legacy equivalente; ponerlo también solo genera el warning
			// de consola "Allow attribute will take precedence over 'allowfullscreen'".
			iframe.allow = "autoplay; fullscreen; picture-in-picture";
			iframe.style.cssText = "position:absolute;inset:0;width:100%;height:100%;border:0;";
			frame.appendChild(iframe);

			player = new window.Vimeo.Player(iframe);

			// Espera a que Vimeo esté "ready" para recién ahí mostrar el video
			// real (evita el flash del poster estático de Vimeo) — pero eso es
			// SOLO sobre cuándo revelarlo visualmente. Mientras tanto se ve la
			// animación de carga en vez de dejar el placeholder solo sin ninguna
			// señal de que el click se registró.
			player
				.ready()
				.then(() => {
					vimeoReady = true;
					if (fallbackTimer) {
						clearTimeout(fallbackTimer);
						fallbackTimer = null;
					}
					if (unmuted) setTimeout(swapToVimeo, 350);
				})
				.catch(() => {});

			// Guarda el progreso cada pocos segundos (timeupdate dispara varias
			// veces por segundo — no hace falta escribir en localStorage tan seguido).
			let lastSaveAt = 0;
			player.on("timeupdate", (data) => {
				const now = Date.now();
				if (now - lastSaveAt < 2000) return;
				lastSaveAt = now;
				safeStorage.set(storageKey, String(Math.floor(data.seconds)));
			});

			// Terminó de verlo — la próxima vez arranca de nuevo desde el principio.
			player.on("ended", () => safeStorage.remove(storageKey));

			return player;
		};

		const activate = () => {
			if (unmuted) return;
			unmuted = true;
			unmuteBtn?.classList.add("is-muted-off");
			showLoading();

			const p = ensurePlayer();
			if (!p) {
				setTimeout(() => {
					unmuted = false;
					activate();
				}, 100);
				return;
			}

			// Estas tres llamadas van ACÁ, sincrónicas, adentro del handler de
			// click real — si se llaman más tarde (dentro de un .then() o un
			// setTimeout) fuera del gesto de click original, los navegadores
			// mobile (sobre todo iOS Safari) pueden bloquear en silencio el
			// play() con sonido por su política de autoplay — el video quedaba
			// revelado pero pausado, sin ningún error visible. El SDK de Vimeo
			// encola estos comandos solo, así que no hace falta esperar a que
			// "ready" resuelva para mandarlos.
			const savedSeconds = Number(safeStorage.get(storageKey)) || 0;
			p.setCurrentTime(savedSeconds).catch(() => {});
			p.setMuted(false).catch(() => {});
			p.play().catch(() => {});

			// Si Vimeo ya está listo, el swap visual pasa casi al toque; si no,
			// se ve la animación de carga hasta que "ready" resuelva (ver más
			// arriba) o, como red de seguridad, hasta 4s como mucho — nunca se
			// deja a la visitante sin ninguna señal de que el click funcionó.
			if (vimeoReady) setTimeout(swapToVimeo, 350);
			else fallbackTimer = setTimeout(swapToVimeo, 4000);
		};

		unmuteBtn?.addEventListener("click", activate);

		const fullscreenBtn = root.querySelector("[data-fullscreen]");
		fullscreenBtn?.addEventListener("click", (event) => {
			event.stopPropagation();
			// Si todavía se estaba viendo el placeholder, "ampliar" también
			// tiene que arrancar el video real — si no, entra a pantalla
			// completa mostrando el iframe muteado/pausado de fondo.
			activate();
			// iOS Safari no soporta la Fullscreen API para iframes — según la
			// versión, requestFullscreen() puede tirar SINCRÓNICO en vez de
			// devolver una promesa rechazada, y un .catch() solo no alcanza para
			// atajar eso. Promise.resolve(...) adentro del try normaliza los dos
			// casos a un mismo camino de fallback.
			try {
				Promise.resolve(player.requestFullscreen()).catch(() => {
					if (iframe.requestFullscreen) iframe.requestFullscreen();
					else if (iframe.webkitRequestFullscreen) iframe.webkitRequestFullscreen();
				});
			} catch {
				if (iframe.requestFullscreen) iframe.requestFullscreen();
				else if (iframe.webkitRequestFullscreen) iframe.webkitRequestFullscreen();
			}
		});
	}

	document.addEventListener("astro:page-load", setupVslVideo);
</script>
