---
interface Props {
    width?: string | number;
    height?: string | number;
    stroke?: string;
    fill?: string;
    class?: string;
}

const { 
    width = 24, 
    height = 24, 
    stroke = "currentColor",
    fill = "currentColor",
    class: className = ""
} = Astro.props;
---

<svg 
    viewBox="0 0 24 24" 
    width={width} 
    height={height}
    xmlns="http://www.w3.org/2000/svg"
    class={className}
>
    <path 
        d="M20 10V7C20 5.89543 19.1046 5 18 5H6C4.89543 5 4 5.89543 4 7V10M20 10V19C20 20.1046 19.1046 21 18 21H6C4.89543 21 4 20.1046 4 19V10M20 10H4M8 3V7M16 3V7" 
        stroke={stroke} 
        stroke-width="1.5" 
        stroke-linecap="round"
        fill="none"
    ></path>
    <rect x="6" y="12" width="3" height="3" rx="0.5" fill={fill}></rect>
    <rect x="10.5" y="12" width="3" height="3" rx="0.5" fill={fill}></rect>
    <rect x="15" y="12" width="3" height="3" rx="0.5" fill={fill}></rect>
</svg>