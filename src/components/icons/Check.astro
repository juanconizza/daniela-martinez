---
interface Props {
	width?: string | number;
	height?: string | number;
	stroke?: string;
	fill?: string;
	class?: string;
	/** Mostrar el círculo alrededor del check (default: true) */
	showCircle?: boolean;
}

const {
	width = 24,
	height = 24,
	stroke = "currentColor",
	fill = "currentColor",
	class: className = "",
	showCircle = true,
} = Astro.props;
---

<svg
	viewBox="0 0 24 24"
	width={width}
	height={height}
	fill={fill}
	xmlns="http://www.w3.org/2000/svg"
	class={className}
>
	{showCircle && (
		<path
			d="M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z"
			stroke={stroke}
			stroke-width="2"
		></path>
	)}
	<path
		d="M9 12L10.6828 13.6828V13.6828C10.858 13.858 11.142 13.858 11.3172 13.6828V13.6828L15 10"
		stroke={stroke}
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
	></path>
</svg>
