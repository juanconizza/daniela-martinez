---
interface Props {
	width?: string | number;
	height?: string | number;
	stroke?: string;
	fill?: string;
	class?: string;
}

const {
	width = 24,
	height = 24,
	stroke = "currentColor",
	fill = "currentColor",
	class: className = "",
} = Astro.props;
---

<svg
	viewBox="0 0 24 24"
	width={width}
	height={height}
	xmlns="http://www.w3.org/2000/svg"
	class={className}
>
	<path
		d="M18.76,6l2,4H3.24l2-4H18.76M20,4H4L1,10v2H3v7H5V16H19v3h2V12h2V10L20,4ZM5,14V12H19v2Z"
		fill={fill}
	/>
	<rect width="24" height="24" fill="none"/>
</svg>
