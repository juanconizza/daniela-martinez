---
// TODO: Reemplazar title, description y keywords con los datos del proyecto
import MainLayout from '../layouts/MainLayout.astro'
---
<MainLayout
  title="[NOMBRE_EMPRESA] | [TAGLINE_PRINCIPAL]"
  description="[DESCRIPCIÓN_SEO_DEL_NEGOCIO]"
  keywords="[KEYWORD_1], [KEYWORD_2], [KEYWORD_3]"
>
  <main class="min-h-screen bg-white font-text flex items-center justify-center px-6">
    <div class="text-center max-w-lg">
      <p class="text-color-primary text-xs uppercase tracking-widest font-medium mb-3">Próximamente</p>
      <h1 class="text-4xl md:text-5xl font-bold text-color-text leading-tight">
        Estamos trabajando en algo increíble
      </h1>
      <p class="mt-4 text-lg text-gray-500">
        Muy pronto tendremos todo listo. ¡Volvé a visitarnos!
      </p>
    </div>
  </main>
</MainLayout>