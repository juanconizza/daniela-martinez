---
/**
 * STATS — Métricas de prueba social
 * TODO: Reemplazar con números reales del negocio
 * TODO: Eliminar esta sección si no hay métricas relevantes
 */
import SlideAnimations from '../../components/animations/SlideAnimations.astro'

// TODO: Completar con las métricas reales del cliente
const stats = [
  { number: '[+N]', label: '[MÉTRICA 1]' },
  { number: '[+N]', label: '[MÉTRICA 2]' },
  { number: '[N]',  label: '[MÉTRICA 3]' },
  { number: '[N]',  label: '[MÉTRICA 4]' },
]
---

<section class="py-16 md:py-24 px-6 bg-color-primary text-white">
  <div class="max-w-4xl mx-auto">
    <SlideAnimations direction="up">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">
        [HEADLINE DE CONFIANZA]
      </h2>
    </SlideAnimations>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      {stats.map((stat, i) => (
        <SlideAnimations direction="up" delay={i * 80}>
          <div>
            <p class="text-4xl font-bold text-color-accent">{stat.number}</p>
            <p class="mt-2 text-sm text-white/70">{stat.label}</p>
          </div>
        </SlideAnimations>
      ))}
    </div>
  </div>
</section>
